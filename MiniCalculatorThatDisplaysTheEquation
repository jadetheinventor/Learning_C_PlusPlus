        std::cout << std::endl << std::endl;
        sum = num1 + num2;
        std::cout << num1 << " " << symbol << " " << num2 << " " << "=" << " " << sum << std::endl;  
    }
    else if(operation == "-" || operation == "minus" || operation == "Minus" || operation == "subtract" || operation == "Subtract" || operation == "subtraction" || operation == "Subtraction"){
        symbol = '-';
        std::cout << num1 << " " << symbol << " ";
