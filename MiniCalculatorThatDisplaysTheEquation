        std::cout << std::endl;
        
        if(num2 == 0){
        std::cout << "Undefined" << std::endl;
        }
      else {
        quotient = num1 / num2;
        whatsLeftOver = num1 % num2;
      
        if(num1 % num2 == 0){
            std::cout << num1 << " " << symbol << " "
                      << num2 << " = " << quotient << std::endl;
        }
          else{
            std::cout << num1 << " " << symbol << " "
                      << num2 << " = " << quotient << std::endl;

            std::cout << "The remainder is: "
                      << whatsLeftOver << std::endl;
          }
      }
}
        std::cout << "Would you like to start over? Type Yes or No: ";
        std::cin >> response;

    }   while(response == "Yes" || response == "yes" || response == "y" || response == "Y");
    
